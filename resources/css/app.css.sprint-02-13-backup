/* =========================================================
   Azari global visual refinements
   ========================================================= */

/* Uploaded logo and text fallback are mutually exclusive in Blade. */
.azari-brand {
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
    color: inherit;
    text-decoration: none;
}

.azari-brand__image {
    display: block;
    width: auto;
    height: 52px;
    max-width: 210px;
    object-fit: contain;
}

.azari-brand--footer .azari-brand__image {
    height: 58px;
    max-width: 220px;
}

.azari-brand__fallback {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
}

.azari-brand__icon {
    font-size: 2rem;
    line-height: 1;
    font-variation-settings:
        "FILL" 0,
        "wght" 200,
        "GRAD" 0,
        "opsz" 40;
}

.azari-brand__words {
    display: flex;
    flex-direction: column;
    color: inherit;
    font-size: 0.75rem;
    font-weight: 650;
    line-height: 1.05;
    letter-spacing: 0.2em;
    text-transform: uppercase;
}

.azari-brand__words strong {
    color: inherit;
    font-size: 1.12rem;
    font-weight: 750;
    letter-spacing: 0.13em;
}

/* Keep Material Symbols visually light throughout the application. */
.material-symbols-outlined,
.material-symbols-rounded,
.material-symbols-sharp {
    font-variation-settings:
        "FILL" 0,
        "wght" 200,
        "GRAD" 0,
        "opsz" 24;
}

/* Preloader remains a simple circular loader only. */
[data-preloader],
.preloader,
.site-preloader,
.page-preloader {
    display: grid;
    place-items: center;
}

[data-preloader] img,
[data-preloader] .azari-brand,
[data-preloader] .preloader-logo,
[data-preloader] .preloader-text,
.preloader img,
.preloader .azari-brand,
.preloader .preloader-logo,
.preloader .preloader-text,
.site-preloader img,
.site-preloader .azari-brand,
.site-preloader .preloader-logo,
.site-preloader .preloader-text {
    display: none !important;
}

[data-preloader]::after,
.preloader::after,
.site-preloader::after,
.page-preloader::after {
    content: "";
    display: block;
    width: 42px;
    height: 42px;
    border: 2px solid currentColor;
    border-right-color: transparent;
    border-radius: 50%;
    animation: azari-loader-spin 0.75s linear infinite;
}

@keyframes azari-loader-spin {
    to {
        transform: rotate(360deg);
    }
}

/* Square back-to-top control with restrained corner radius. */
[data-back-to-top],
.back-to-top,
#back-to-top {
    position: fixed;
    right: clamp(1rem, 3vw, 2rem);
    bottom: clamp(1rem, 3vw, 2rem);
    z-index: 60;
    display: inline-grid;
    place-items: center;
    width: 48px;
    height: 48px;
    padding: 0;
    border: 1px solid currentColor;
    border-radius: 10px !important;
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(16px) scale(0.94);
    transition:
        opacity 220ms ease,
        visibility 220ms ease,
        transform 220ms ease,
        background-color 180ms ease,
        color 180ms ease,
        box-shadow 180ms ease;
}

[data-back-to-top].is-visible,
.back-to-top.is-visible,
#back-to-top.is-visible {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0) scale(1);
}

[data-back-to-top]:hover,
.back-to-top:hover,
#back-to-top:hover {
    transform: translateY(-4px) scale(1.03);
    box-shadow: 0 10px 28px rgb(0 0 0 / 18%);
}

[data-back-to-top]:active,
.back-to-top:active,
#back-to-top:active {
    transform: translateY(-1px) scale(0.97);
}

[data-back-to-top]:focus-visible,
.back-to-top:focus-visible,
#back-to-top:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
}

/* Explicit hero image source. */
.azari-hero-media {
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
        linear-gradient(
            90deg,
            rgb(0 0 0 / 58%),
            rgb(0 0 0 / 18%)
        ),
        url("/images/azari-hero.jpg") center / cover no-repeat;
}

.hero,
.hero-section,
[data-hero] {
    position: relative;
    isolation: isolate;
}

.hero > :not(.azari-hero-media),
.hero-section > :not(.azari-hero-media),
[data-hero] > :not(.azari-hero-media) {
    position: relative;
    z-index: 1;
}

/* Avoid washed-out descriptive copy. */
main p,
main li,
main .description,
main .section-description,
main .service-description,
main .property-description {
    opacity: 1;
}

@media (max-width: 640px) {
    .azari-brand__image {
        height: 44px;
        max-width: 165px;
    }

    [data-back-to-top],
    .back-to-top,
    #back-to-top {
        width: 44px;
        height: 44px;
        border-radius: 9px !important;
    }
}

@media (prefers-reduced-motion: reduce) {
    [data-back-to-top],
    .back-to-top,
    #back-to-top {
        transition: none;
    }

    [data-preloader]::after,
    .preloader::after,
    .site-preloader::after,
    .page-preloader::after {
        animation-duration: 1.4s;
    }
}

