    font-size: 25px;
    font-weight: 400;
    line-height: 1.45;
}

.testimonial-grid footer {
    display: grid;
    gap: 4px;
    margin-top: 26px;
}

.testimonial-grid footer strong {
    color: var(--azari-brass-light);
    font-size: 12px;
}

.testimonial-grid footer span {
    color: rgba(243, 236, 221, 0.56);
    font-size: 11px;
}

.site-footer {
    background: #09130e;
    padding: 86px 0 28px;
    color: rgba(243, 236, 221, 0.7);
}

.footer-primary {
    display: grid;
    grid-template-columns: 1.6fr repeat(3, 1fr);
    gap: 60px;
}

.footer-logo-slot {
    display: inline-flex;
    min-height: 58px;
    align-items: center;
    gap: 10px;
    border: 1px dashed rgba(243, 236, 221, 0.28);
    border-radius: 8px;
    padding: 10px 14px;
    color: var(--azari-brass-light);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
}

.footer-brand p {
    max-width: 350px;
    margin: 22px 0 0;
    font-size: 13px;
    line-height: 1.75;
}

.footer-column {
    display: grid;
    align-content: start;
    gap: 13px;
}

.footer-column h2 {
    margin: 0 0 8px;
    color: var(--azari-ivory);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
}

.footer-column a,
.footer-column button {
    width: fit-content;
    border: 0;
    background: transparent;
    padding: 0;
    color: inherit;
    font-size: 12px;
    text-align: left;
}

.footer-column a:hover,
.footer-column button:hover {
    color: var(--azari-brass-light);
}

.footer-newsletter {
    display: grid;
    grid-template-columns: 1fr 0.8fr;
    align-items: end;
    gap: 50px;
    margin-top: 70px;
    border-top: 1px solid rgba(243, 236, 221, 0.12);
    padding-top: 42px;
}

.footer-newsletter h2 {
    max-width: 620px;
    margin: 12px 0 0;
    color: var(--azari-ivory);
    font-family: var(--font-display);
    font-size: 31px;
    font-weight: 500;
    line-height: 1.2;
}

.newsletter-form {
    display: flex;
    gap: 10px;
}

.luxury-input {
    width: 100%;
    min-height: 48px;
    border: 1px solid rgba(243, 236, 221, 0.24);
    border-radius: 5px;
    background: rgba(243, 236, 221, 0.06);
    padding: 11px 14px;
    color: var(--azari-ivory);
    outline: none;
}

.luxury-input::placeholder {
    color: rgba(243, 236, 221, 0.42);
}

.luxury-input:focus {
    border-color: var(--azari-brass-light);
    box-shadow: 0 0 0 4px rgba(187, 138, 62, 0.13);
}

.footer-legal {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 50px;
    border-top: 1px solid rgba(243, 236, 221, 0.1);
    padding-top: 24px;
    font-size: 10px;
}

.footer-legal a {
    margin-left: auto;
    color: var(--azari-brass-light);
}

.back-to-top {
    position: fixed;
    z-index: 80;
    right: 22px;
    bottom: 22px;
    display: grid;
    width: 46px;
    height: 46px;
    place-items: center;
    transform: translateY(20px);
    border: 1px solid rgba(243, 236, 221, 0.22);
    border-radius: 50%;
    background: var(--azari-ink);
    color: var(--azari-ivory);
    opacity: 0;
    pointer-events: none;
    box-shadow: var(--shadow-card);
    transition: opacity 180ms ease, transform 180ms ease;
}

.back-to-top.is-visible {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
}

.modal-layer,
.drawer-layer {
    position: fixed;
    z-index: 500;
    inset: 0;
}

.modal-backdrop,
.drawer-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(5, 14, 9, 0.72);
    opacity: 0;
    backdrop-filter: blur(4px);
    transition: opacity 220ms ease;
}

.modal-layer.is-open .modal-backdrop,
.drawer-layer.is-open .drawer-backdrop {
    opacity: 1;
}

.modal-dialog {
    position: absolute;
    z-index: 1;
    top: 50%;
    left: 50%;
    width: min(570px, calc(100% - 32px));
    max-height: calc(100vh - 32px);
    overflow-y: auto;
    transform: translate(-50%, calc(-50% + 20px));
    border-radius: 13px;
    background: var(--azari-ivory);
    padding: 38px;
    opacity: 0;
    box-shadow: var(--shadow-floating);
    transition: opacity 220ms ease, transform 220ms ease;
}

.modal-layer.is-open .modal-dialog {
    transform: translate(-50%, -50%);
    opacity: 1;
}

.modal-dialog h2 {
    margin: 12px 0 0;
    color: var(--azari-ink);
    font-family: var(--font-display);
    font-size: 36px;
    font-weight: 500;
}

.modal-dialog > p {
    margin: 14px 0 0;
    color: var(--azari-muted);
    font-size: 14px;
    line-height: 1.7;
}

.modal-close {
    display: grid;
    width: 40px;
    height: 40px;
    place-items: center;
    border: 1px solid var(--azari-border);
    border-radius: 50%;
    background: transparent;
    color: var(--azari-ink);
}

.modal-dialog > .modal-close {
    position: absolute;
    top: 18px;
    right: 18px;
}

.verification-form {
    margin-top: 25px;
}

.verification-form label {
    display: block;
    margin-bottom: 8px;
    color: var(--azari-ink);
    font-size: 12px;
    font-weight: 700;
}

.verification-form .luxury-input {
    border-color: var(--azari-border);
    background: white;
    color: var(--azari-text);
}

.verification-form .luxury-input::placeholder {
    color: #92968f;
}

.field-with-action {
    display: flex;
    gap: 10px;
}

.drawer-panel {
    position: absolute;
    z-index: 1;
    top: 0;
    right: 0;
    display: flex;
    width: min(410px, 92vw);
    height: 100%;
    flex-direction: column;
    transform: translateX(100%);
    background: var(--azari-ivory);
    padding: 22px;
    box-shadow: var(--shadow-floating);
    transition: transform 240ms ease;
}

.drawer-layer.is-open .drawer-panel {
    transform: translateX(0);
}

.drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.mobile-navigation {
    display: grid;
    margin-top: 35px;
}

.mobile-navigation a,
.mobile-navigation button {
    display: flex;
    width: 100%;
    border: 0;
    border-bottom: 1px solid var(--azari-border);
    background: transparent;
    padding: 15px 0;
    color: var(--azari-ink);
    font-family: var(--font-display);
    font-size: 21px;
    text-align: left;
}

.drawer-actions {
    display: grid;
    gap: 10px;
    margin-top: auto;
    padding-top: 28px;
}

.toast-region {
    position: fixed;
    z-index: 700;
    right: 20px;
    bottom: 82px;
    display: grid;
    width: min(380px, calc(100% - 40px));
    gap: 10px;
    pointer-events: none;
}

.toast {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 11px;
    transform: translateY(14px);
    border: 1px solid rgba(243, 236, 221, 0.16);
    border-radius: 8px;
    background: var(--azari-ink);
    padding: 14px;
    color: var(--azari-ivory);
    opacity: 0;
    box-shadow: var(--shadow-card);
    pointer-events: auto;
    transition: opacity 180ms ease, transform 180ms ease;
}

.toast.is-visible {
    transform: translateY(0);
    opacity: 1;
}

.toast > .material-symbols-outlined {
    color: var(--azari-brass-light);
}

.toast-success > .material-symbols-outlined {
    color: #75d5a6;
}

.toast button {
    display: grid;
    width: 30px;
    height: 30px;
    place-items: center;
    border: 0;
    background: transparent;
    color: inherit;
}

.search-results-hero {
    padding: 160px 0 68px;
    background: var(--azari-ink);
    color: var(--azari-ivory);
}

.search-results-hero h1 {
    margin: 15px 0 0;
    font-family: var(--font-display);
    font-size: clamp(44px, 6vw, 70px);
    font-weight: 500;
}

.search-results-hero p {
    margin: 17px 0 0;
    color: rgba(243, 236, 221, 0.67);
}

.search-results-content {
    min-height: 520px;
    padding: 70px 0 100px;
}

.results-layout {
    display: grid;
    grid-template-columns: 290px 1fr;
    gap: 30px;
    align-items: start;
}

.search-summary-card,
.results-panel {
    border-radius: 10px;
    background: white;
    padding: 26px;
    box-shadow: var(--shadow-card);
}

.search-summary-card h2,
.results-panel h2 {
    margin: 0;
    color: var(--azari-ink);
    font-family: var(--font-display);
    font-size: 25px;
    font-weight: 500;
}

.search-summary-card dl {
    display: grid;
    gap: 0;
    margin: 20px 0;
}

.search-summary-card dl div {
    display: flex;
    justify-content: space-between;
    gap: 15px;
    border-top: 1px solid var(--azari-border);
    padding: 12px 0;
}

.search-summary-card dt {
    color: var(--azari-muted);
    font-size: 11px;
}

.search-summary-card dd {
    margin: 0;
    color: var(--azari-ink);
    font-size: 12px;
    font-weight: 700;
    text-align: right;
}

.empty-search-state {
    display: grid;
    min-height: 390px;
    place-items: center;
    align-content: center;
    padding: 40px;
    text-align: center;
}

.empty-search-state > .material-symbols-outlined {
    color: var(--azari-brass);
    font-size: 56px;
}

.empty-search-state h2 {
    max-width: 550px;
    margin-top: 18px;
    font-size: 34px;
}

.empty-search-state p {
    max-width: 610px;
    margin: 14px 0 0;
    color: var(--azari-muted);
    font-size: 14px;
    line-height: 1.75;
}

.empty-search-state .button {
    margin-top: 24px;
}

@media (max-width: 1080px) {
    .desktop-navigation,
    .nav-actions > .nav-text-action {
        display: none;
    }

    .mobile-menu-button {
        display: grid;
    }

    .availability-form {
        grid-template-columns: repeat(3, 1fr);
        gap: 18px 0;
    }

    .search-field:nth-child(3) {
        border-right: 0;
    }

    .availability-submit {
        min-height: 54px;
    }

    .residence-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .service-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 820px) {
    .hero-section {
        min-height: 700px;
    }

    .hero-content {
        padding-bottom: 120px;
    }

    .availability-form {
        grid-template-columns: repeat(2, 1fr);
    }

    .search-field {
        border-right: 0;
        border-bottom: 1px solid rgba(18, 33, 27, 0.1);
        padding: 5px 14px 14px;
    }

    .search-field:nth-child(odd) {
        border-right: 1px solid rgba(18, 33, 27, 0.1);
    }

    .search-field-location {
        grid-column: span 2;
        border-right: 0 !important;
    }

    .availability-submit {
        grid-column: span 2;
    }

    .intro-grid,
    .guide-grid,
    .footer-newsletter,
    .results-layout {
        grid-template-columns: 1fr;
        gap: 45px;
    }

    .residence-grid {
        grid-template-columns: 1fr;
    }

    .footer-primary {
        grid-template-columns: repeat(2, 1fr);
    }

    .testimonial-grid {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 620px) {
    .site-container {
        width: min(calc(100% - 32px), var(--container));
    }

    .site-header {
        padding: 14px 0;
    }

    .nav-actions > .button {
        display: none;
    }

    .brand-copy strong {
        font-size: 18px;
    }

    .hero-section {
        min-height: 650px;
    }

    .hero-content {
        padding-top: 105px;
        padding-bottom: 105px;
    }

    .hero-copy h1 {
        font-size: clamp(45px, 14vw, 62px);
    }

    .hero-copy p {
        font-size: 16px;
    }

    .hero-actions {
        align-items: stretch;
        flex-direction: column;
    }

    .availability-section {
        margin-top: -52px;
    }

    .availability-heading {
        padding: 24px 20px 0;
    }

    .availability-heading h2 {
        font-size: 29px;
    }

    .availability-form {
        grid-template-columns: 1fr;
        padding: 20px;
    }

    .search-field,
    .search-field:nth-child(odd),
    .search-field-location {
        grid-column: auto;
        border-right: 0 !important;
        padding: 5px 3px 15px;
    }

    .availability-submit {
        grid-column: auto;
    }

    .guest-selector-panel {
        position: fixed;
        z-index: 550;
        top: auto;
        right: 16px;
        bottom: 16px;
        left: 16px;
        width: auto;
        transform: none;
    }

    .intro-section,
    .residences-section,
    .guide-section,
    .testimonial-section,
    .services-section {
        padding: 76px 0;
    }

    .intro-grid {
        gap: 36px;
    }

    .stat-grid {
        gap: 20px;
    }

    .section-heading {
        align-items: start;
        flex-direction: column;
    }

    .service-grid {
        grid-template-columns: 1fr;
    }

    .service-card {
        min-height: auto;
    }

    .guide-visual {
        min-height: 370px;
    }

    .footer-primary {
        grid-template-columns: 1fr;
        gap: 38px;
    }

    .newsletter-form,
    .field-with-action {
        align-items: stretch;
        flex-direction: column;
    }

    .footer-legal a {
        margin-left: 0;
    }

    .modal-dialog {
        padding: 32px 22px 24px;
    }

    .toast-region {
        right: 16px;
        bottom: 74px;
        width: calc(100% - 32px);
    }

    .search-results-hero {
        padding-top: 135px;
    }

    .search-summary-card,
    .results-panel {
        padding: 20px;
    }

    .empty-search-state {
        padding: 30px 5px;
    }
}

@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        scroll-behavior: auto !important;
        transition-duration: 0.01ms !important;
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
    }
}

/* Sprint 2.5 production additions */
.public-preloader {
    position: fixed;
    z-index: 9999;
    inset: 0;
    display: grid;
    place-items: center;
    background: var(--azari-ink);
    opacity: 1;
    visibility: visible;
    transition: opacity 420ms ease, visibility 420ms ease;
}

.public-preloader.is-hidden {
    opacity: 0;
    visibility: hidden;
}

.public-preloader-mark {
    position: relative;
    display: grid;
    width: 112px;
    height: 112px;
    place-items: center;
}

.public-preloader-mark img {
    width: 58px;
    max-height: 58px;
    object-fit: contain;
    animation: azari-pulse 1.55s ease-in-out infinite;
}

.public-preloader-mark > .material-symbols-outlined {
    color: var(--azari-brass-light);
    font-size: 46px;
    animation: azari-pulse 1.55s ease-in-out infinite;
}

.public-preloader-ring {
    position: absolute;
    inset: 0;
    border: 1.5px solid rgba(243, 236, 221, 0.18);
    border-top-color: var(--azari-brass-light);
    border-right-color: transparent;
    border-radius: 50%;
    animation: azari-spin 1.05s linear infinite;
}

@keyframes azari-spin { to { transform: rotate(360deg); } }
@keyframes azari-pulse { 50% { transform: scale(.9); opacity: .58; } }

.brand-image {
    width: auto;
    max-width: 170px;
    height: 44px;
    object-fit: contain;
}

.footer-brand-image {
    width: auto;
    max-width: 210px;
    max-height: 72px;
    object-fit: contain;
}

.desktop-navigation {
    min-width: 0;
    flex-shrink: 1;
    white-space: nowrap;
}

.desktop-navigation > a,
.nav-popover-trigger,
.nav-actions {
    white-space: nowrap;
}

.residence-image img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.property-card-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 14px;
}

.property-card-facts span {
    border: 1px solid var(--azari-border);
    border-radius: 999px;
    padding: 6px 9px;
    color: var(--azari-muted);
    font-size: 10px;
    font-weight: 600;
}

.production-empty-state {
    grid-column: 1 / -1;
    border: 1px solid var(--azari-border);
    border-radius: 10px;
    padding: 50px;
    text-align: center;
}

.property-detail-hero {
    padding: 170px 0 80px;
    background: var(--azari-ink);
    color: var(--azari-ivory);
}

.property-detail-hero h1 {
    margin: 14px 0 0;
    font-family: var(--font-display);
    font-size: clamp(46px, 7vw, 78px);
    font-weight: 500;
}

.property-detail-hero p {
    max-width: 700px;
    color: rgba(243, 236, 221, .68);
}

.property-gallery-section {
    padding: 70px 0 110px;
}

.property-gallery {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    grid-auto-rows: 210px;
    gap: 12px;
}

.property-gallery img {
    width: 100%;
    height: 100%;
    border-radius: 8px;
    object-fit: cover;
