    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.72rem;
    min-height: 54px;
    padding: 0.95rem 1.5rem;
    border-radius: 3px;
    font-size: 0.78rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
    transition:
        transform 180ms ease,
        background-color 180ms ease,
        border-color 180ms ease,
        color 180ms ease;
}

.azari-home-hero__primary {
    border: 1px solid #d8b87a;
    background: #d8b87a;
    color: #11271e;
}

.azari-home-hero__primary:hover {
    border-color: #efd7a7;
    background: #efd7a7;
    color: #11271e;
    transform: translateY(-2px);
}

.azari-home-hero__secondary {
    border: 1px solid rgba(255, 250, 241, 0.55);
    background: rgba(13, 34, 25, 0.35);
    color: #fffaf1;
    backdrop-filter: blur(12px);
}

.azari-home-hero__secondary:hover {
    border-color: #fffaf1;
    background: rgba(255, 250, 241, 0.13);
    color: #fffaf1;
    transform: translateY(-2px);
}

.azari-home-hero__actions .material-symbols-outlined {
    font-size: 1.1rem;
    font-variation-settings:
        "FILL" 0,
        "wght" 250,
        "GRAD" 0,
        "opsz" 24;
}

.azari-home-hero__scroll {
    position: absolute;
    right: clamp(1.5rem, 5vw, 5rem);
    bottom: 2rem;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: rgba(255, 250, 241, 0.8);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-decoration: none;
    text-transform: uppercase;
}

.azari-home-hero__scroll .material-symbols-outlined {
    font-size: 1.1rem;
    font-variation-settings:
        "FILL" 0,
        "wght" 200,
        "GRAD" 0,
        "opsz" 24;
    animation: azariHeroScroll 1.8s ease-in-out infinite;
}

.azari-featured-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
}

.azari-view-all-residences {
    display: inline-flex !important;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    min-height: 50px;
    padding: 0.9rem 1.35rem;
    border: 1px solid #173c30;
    border-radius: 3px;
    background: #173c30;
    color: #fffaf1 !important;
    font-size: 0.76rem;
    font-weight: 650;
    line-height: 1;
    letter-spacing: 0.08em;
    opacity: 1 !important;
    text-decoration: none;
    text-transform: uppercase;
    visibility: visible !important;
    transition:
        transform 180ms ease,
        background-color 180ms ease,
        border-color 180ms ease;
}

.azari-view-all-residences:hover {
    border-color: #285b49;
    background: #285b49;
    color: #fffaf1 !important;
    transform: translateY(-2px);
}

.azari-view-all-residences .material-symbols-outlined {
    font-size: 1.1rem;
    font-variation-settings:
        "FILL" 0,
        "wght" 250,
        "GRAD" 0,
        "opsz" 24;
    transition: transform 180ms ease;
}

.azari-view-all-residences:hover .material-symbols-outlined {
    transform: translateX(4px);
}

.azari-featured-mobile-action {
    display: none;
    margin-top: 2rem;
}

@keyframes azariHeroScroll {
    0%,
    100% {
        transform: translateY(0);
    }

    50% {
        transform: translateY(5px);
    }
}

@media (max-width: 800px) {
    .azari-home-hero {
        min-height: min(850px, 94svh);
    }

    .azari-home-hero__image {
        object-position: 60% center;
    }

    .azari-home-hero__overlay {
        background:
            linear-gradient(
                0deg,
                rgba(7, 18, 13, 0.95) 0%,
                rgba(7, 18, 13, 0.7) 55%,
                rgba(7, 18, 13, 0.28) 100%
            );
    }

    .azari-home-hero__container {
        padding-top: 9rem;
        padding-bottom: 4rem;
    }

    .azari-home-hero h1 {
        font-size: clamp(3rem, 14vw, 5.2rem);
        line-height: 0.98;
    }

    .azari-home-hero p {
        font-size: 1rem;
        line-height: 1.7;
    }

    .azari-home-hero__actions {
        align-items: stretch;
        flex-direction: column;
    }

    .azari-home-hero__primary,
    .azari-home-hero__secondary {
        width: 100%;
    }

    .azari-home-hero__scroll {
        display: none;
    }

    .azari-featured-heading > .azari-view-all-residences {
        display: none !important;
    }

    .azari-featured-mobile-action {
        display: block;
    }

    .azari-featured-mobile-action .azari-view-all-residences {
        width: 100%;
    }
}

/* AZARI_HOMEPAGE_FINAL_END */

/* AZARI_PUBLIC_UI_REPAIR_START */

.azari-preloader {
    position: fixed;
    inset: 0;
    z-index: 99999;
    display: grid;
    place-items: center;
    background: #f7f3eb;
    transition:
        opacity 280ms ease,
        visibility 280ms ease;
}

.azari-preloader__spinner {
    display: block;
    width: 46px;
    height: 46px;
    border: 1.5px solid rgba(23, 60, 48, 0.17);
    border-top-color: #173c30;
    border-right-color: #173c30;
    border-bottom-color: transparent;
    border-radius: 50%;
    animation: azariPreloaderSpin 720ms linear infinite;
}

.azari-preloader.is-hidden {
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
}

@keyframes azariPreloaderSpin {
    to {
        transform: rotate(360deg);
    }
}

.back-to-top,
.scroll-to-top,
[data-back-to-top],
#back-to-top {
    -webkit-tap-highlight-color: transparent;
}

.back-to-top:focus,
.back-to-top:focus-visible,
.back-to-top:active,
.scroll-to-top:focus,
.scroll-to-top:focus-visible,
.scroll-to-top:active,
[data-back-to-top]:focus,
[data-back-to-top]:focus-visible,
[data-back-to-top]:active,
#back-to-top:focus,
#back-to-top:focus-visible,
#back-to-top:active {
    outline: none !important;
    box-shadow: none !important;
}

.back-to-top::-moz-focus-inner,
.scroll-to-top::-moz-focus-inner,
[data-back-to-top]::-moz-focus-inner,
#back-to-top::-moz-focus-inner {
    border: 0;
}

.azari-home-hero {
    box-sizing: border-box;
    width: 100%;
    max-width: 100%;
    overflow: hidden;
}

.azari-home-hero__container {
    box-sizing: border-box;
    width: 100%;
    min-width: 0;
    max-width: 100%;
}

.azari-home-hero__content {
    box-sizing: border-box;
    width: min(100%, 790px);
    min-width: 0;
    max-width: 100%;
}

.azari-home-hero__eyebrow,
.azari-home-hero h1,
.azari-home-hero p,
.azari-home-hero__actions {
    box-sizing: border-box;
    max-width: 100%;
}

.azari-home-hero h1,
.azari-home-hero p {
    overflow-wrap: break-word;
}

.azari-home-hero__primary,
.azari-home-hero__secondary {
    box-sizing: border-box;
    max-width: 100%;
    white-space: normal;
}

@media (max-width: 800px) {
    .azari-home-hero__container {
        padding-right: max(1.25rem, env(safe-area-inset-right));
        padding-left: max(1.25rem, env(safe-area-inset-left));
    }

    .azari-home-hero__content {
        width: 100%;
    }

    .azari-home-hero h1 {
        font-size: clamp(2.8rem, 12vw, 4.8rem);
        line-height: 0.98;
        letter-spacing: -0.04em;
    }
}

@media (max-width: 420px) {
    .azari-home-hero h1 {
        font-size: clamp(2.45rem, 11.5vw, 3.7rem);
    }

    .azari-home-hero__eyebrow {
        letter-spacing: 0.13em;
    }
}

/* AZARI_PUBLIC_UI_REPAIR_END */

