    right: 0;
    color: rgba(243, 236, 221, 0.13);
    font-family: var(--font-display);
    font-size: 90px;
    line-height: 1;
}

.testimonial-grid blockquote > p {
    position: relative;
    max-width: 480px;
    margin: 0;
    color: var(--azari-ivory);
