}

.guide-copy > p {
    margin-top: 22px;
}

.guide-copy .button {
    margin-top: 28px;
}

.testimonial-section {
    background: var(--azari-wine);
}

.testimonial-section .eyebrow {
    color: var(--azari-brass-light);
}

.testimonial-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 34px;
    margin-top: 34px;
}

.testimonial-grid blockquote {
    position: relative;
    margin: 0;
    border-top: 1px solid rgba(243, 236, 221, 0.2);
    padding: 30px 0 0;
}

.quote-mark {
    position: absolute;
