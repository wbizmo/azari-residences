}

.property-detail-grid h2 {
    font-family: var(--font-display);
    font-size: 38px;
    font-weight: 500;
}

.property-detail-grid article > p {
    color: var(--azari-muted);
    line-height: 1.8;
}

.property-detail-grid aside {
