<script>
(() => {
    const popup = document.querySelector('[data-promotion-popup]');
    if (!popup) return;

    const dialog = popup.querySelector('[data-promotion-dialog]');
    const key = `azari-promotion-seen-${popup.dataset.promotionId}`;
    let lastFocused = null;

    const close = () => {
        popup.classList.remove('is-visible');
        document.body.classList.remove('is-locked');

        window.setTimeout(() => {
            popup.hidden = true;
            lastFocused?.focus?.();
        }, 230);

        try { sessionStorage.setItem(key, '1'); } catch (_) {}
    };

    const open = () => {
        lastFocused = document.activeElement;
        popup.hidden = false;

        requestAnimationFrame(() => {
            popup.classList.add('is-visible');
            document.body.classList.add('is-locked');
            dialog?.focus();
        });
    };

    popup.querySelectorAll('[data-promotion-close]').forEach((element) => {
        element.addEventListener('click', close);
    });

    document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && popup.classList.contains('is-visible')) close();
    });

    window.addEventListener('load', () => {
        let seen = false;
        try { seen = sessionStorage.getItem(key) === '1'; } catch (_) {}
        if (!seen) window.setTimeout(open, 650);
    }, { once:true });
})();
</script>
