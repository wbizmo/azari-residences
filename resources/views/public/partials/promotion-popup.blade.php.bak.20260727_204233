<script>
(() => {
 const popup=document.querySelector('[data-promotion-popup]'); if(!popup)return;
 const dialog=popup.querySelector('[data-promotion-dialog]');
 const key=`azari-promotion-seen-${popup.dataset.promotionId}`;
 const close=()=>{popup.classList.remove('is-visible');document.body.classList.remove('is-locked');setTimeout(()=>popup.hidden=true,250);try{sessionStorage.setItem(key,'1')}catch(e){}};
 const open=()=>{popup.hidden=false;requestAnimationFrame(()=>{popup.classList.add('is-visible');document.body.classList.add('is-locked');dialog?.focus()})};
 popup.querySelectorAll('[data-promotion-close]').forEach(btn=>btn.addEventListener('click',close));
 popup.addEventListener('click',e=>{if(e.target===popup)close()});
 document.addEventListener('keydown',e=>{if(e.key==='Escape'&&popup.classList.contains('is-visible'))close()});
 window.addEventListener('load',()=>{let seen=false;try{seen=sessionStorage.getItem(key)==='1'}catch(e){} if(!seen)setTimeout(open,550)},{once:true});
})();
</script>
