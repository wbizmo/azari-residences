<IfModule mod_rewrite.c>
    RewriteEngine On

    # Resavar intentionally has no favicon. Do not rewrite browser favicon
    # probes into Laravel or another image.
    RewriteRule ^favicon\.(?:ico|png|svg)$ - [R=404,L,NC]

    # Hostinger points resavar.com at public_html while Laravel's web root
    # is public_html/public. Forward public requests into Laravel's public
    # directory without exposing or moving the application itself.
    RewriteCond %{REQUEST_URI} !^/public(?:/|$)
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
