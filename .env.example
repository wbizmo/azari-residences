APP_NAME="Azari Residences"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
ASSET_URL=
APP_TIMEZONE=Africa/Lagos
AZARI_TIMEZONE=Africa/Lagos

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=azari_residences
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=azari_residences_
FILESYSTEM_DISK=local
BACKUP_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --------------------------------------------------------------------------
# Azari platform
# --------------------------------------------------------------------------
AZARI_BOOKING_HOLD_MINUTES=15
AZARI_DEFAULT_TAX_RATE=0
AZARI_DEFAULT_SERVICE_FEE=0
AZARI_ALLOW_SAME_DAY_BOOKING=false
AZARI_IDENTITY_MAX_KB=10240
AZARI_PHONE_VERIFICATION_ENABLED=false

AZARI_CONTACT_RECIPIENT_EMAIL=
AZARI_SERVICE_REQUEST_EMAIL=
AZARI_SUPPORT_TICKET_EMAIL=
AZARI_BOOKING_NOTIFICATION_EMAIL=

# Shared integration reliability controls
AZARI_INTEGRATIONS_REQUIRE_HTTPS=true
AZARI_INTEGRATION_HTTP_TIMEOUT=20
AZARI_INTEGRATION_CONNECT_TIMEOUT=8
AZARI_PAYMENT_RECONCILE_LIMIT=100
AZARI_WEBHOOK_QUEUE=integrations

# --------------------------------------------------------------------------
# Flutterwave Standard / API v3
# Dashboard webhook URL:
# ${APP_URL}/payments/flutterwave/webhook
# --------------------------------------------------------------------------
FLUTTERWAVE_ENABLED=false
FLUTTERWAVE_MODE=test
FLUTTERWAVE_API_VERSION=v3
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com
FLUTTERWAVE_INITIALISE_PATH=/v3/payments
FLUTTERWAVE_VERIFY_PATH=/v3/transactions/{id}/verify
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
FLUTTERWAVE_PAYLOAD_HASH_ENABLED=false

# --------------------------------------------------------------------------
# Pesapal API 3.0
# Register the IPN URL in Pesapal, then place its returned UUID below.
# IPN URL: ${APP_URL}/payments/pesapal/webhook
# --------------------------------------------------------------------------
PESAPAL_ENABLED=false
PESAPAL_MODE=sandbox
PESAPAL_BASE_URL=https://cybqa.pesapal.com/pesapalv3
PESAPAL_AUTH_PATH=/api/Auth/RequestToken
PESAPAL_SUBMIT_ORDER_PATH=/api/Transactions/SubmitOrderRequest
PESAPAL_STATUS_PATH=/api/Transactions/GetTransactionStatus
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_CALLBACK_URL="${APP_URL}/payments/pesapal/callback"
PESAPAL_NOTIFICATION_ID=
PESAPAL_TOKEN_CACHE_SECONDS=240

# --------------------------------------------------------------------------
# InTouch
# This provider is intentionally fail-closed until its exact merchant API
# contract is confirmed. Set INTOUCH_API_PROFILE=custom_v1 only after entering
# the official base URL, paths, authentication mode, response fields and
# webhook signature contract supplied in your merchant account documentation.
# --------------------------------------------------------------------------
INTOUCH_ENABLED=false
INTOUCH_MODE=test
INTOUCH_API_PROFILE=
INTOUCH_BASE_URL=
INTOUCH_INITIALISE_PATH=/api/v1/payments/initialize
INTOUCH_VERIFY_PATH=/api/v1/payments/{reference}
INTOUCH_HEALTH_PATH=
INTOUCH_MERCHANT_ID=
INTOUCH_USERNAME=
INTOUCH_PASSWORD=
INTOUCH_SECRET=
INTOUCH_API_TOKEN=
INTOUCH_AUTH_MODE=basic_and_headers
INTOUCH_TOKEN_HEADER=x-intouch-o-token
INTOUCH_MERCHANT_HEADER=X-Merchant-ID
INTOUCH_SECRET_HEADER=X-API-Secret
INTOUCH_CALLBACK_URL="${APP_URL}/payments/intouch/callback"
INTOUCH_WEBHOOK_SECRET=
INTOUCH_WEBHOOK_SIGNATURE_HEADER=x-intouch-signature
INTOUCH_CHECKOUT_URL_FIELD=checkout_url
INTOUCH_PROVIDER_REFERENCE_FIELD=transaction_id
INTOUCH_MERCHANT_REFERENCE_FIELD=merchant_reference
INTOUCH_STATUS_FIELD=status
INTOUCH_AMOUNT_FIELD=amount
INTOUCH_CURRENCY_FIELD=currency
INTOUCH_SUCCESSFUL_STATUSES=SUCCESS,SUCCESSFUL,COMPLETED,PAID
INTOUCH_FAILED_STATUSES=FAILED,DECLINED,CANCELLED,INVALID

# --------------------------------------------------------------------------
# Twilio Programmable Messaging
# Status callback route:
# ${APP_URL}/webhooks/twilio/message-status
# Use either a Messaging Service SID or a From number.
# --------------------------------------------------------------------------
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_BASE_URL=https://api.twilio.com
TWILIO_API_VERSION=2010-04-01
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
TWILIO_STATUS_CALLBACK_URL="${APP_URL}/webhooks/twilio/message-status"
TWILIO_VALIDATE_WEBHOOKS=true
TWILIO_DEFAULT_COUNTRY_CODE=234

TWILIO_WHATSAPP_ENABLED=false
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_CONTENT_BOOKING_CONFIRMED=
TWILIO_WHATSAPP_CONTENT_BOOKING_REMINDER=
TWILIO_WHATSAPP_CONTENT_PAYMENT_CONFIRMED=

# Property-owner payouts
STRIPE_SECRET=
STRIPE_BASE_URL=https://api.stripe.com
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

CAPTCHA_ENABLED=false
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

MAPS_ENABLED=false
MAPS_PROVIDER=
MAPS_API_KEY=
